FLASK_APP=wsgi.py

# Generar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR-POR-VALOR-SEGURO

# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Obligatoria para cifrar secretos en BD: MaxMind, SMTP, claves LLM del SOC, token Telegram
WARDNODE_SECRET_KEY=CAMBIAR-POR-FERNET-KEY

DATABASE_URL=postgresql+psycopg://app:CAMBIAR_PASSWORD@127.0.0.1:5432/app
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=CAMBIAR_PASSWORD

PROXY_CONFIG_DIR=/app/generated/nginx
GEOIP_DB_PATH=/app/data/geoip/GeoLite2-Country.mmdb
NGINX_CONTAINER_NAME=wardnode-proxy
# Contenedor del que se ingieren los eventos ModSecurity (WAF Events + módulo SOC)
WARDNODE_PROXY_CONTAINER=wardnode-proxy

SESSION_COOKIE_SECURE=true
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URI=memory://
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_SHOW_TOKEN=false
# URL pública de la consola (sin barra final, OBLIGATORIA en producción, debe ser https://).
# Se usa para construir el enlace en correos de recuperación de contraseña.
# Sin esta variable el servidor no arranca en modo producción.
PUBLIC_BASE_URL=https://tu-dominio.com

# Hosts permitidos en el header HTTP Host (lista separada por comas).
# Rechaza requests con Host no listado — protege contra Host header poisoning.
TRUSTED_HOSTS=tu-dominio.com

# WardNode OBS — contraseña del admin de Grafana (módulo observabilidad)
GRAFANA_ADMIN_PASSWORD=CAMBIAR-POR-CONTRASENA-SEGURA

# Ruta absoluta al directorio del proyecto en el VPS host (necesaria para que el módulo OBS
# levante los contenedores de observabilidad desde el panel). Ej: /opt/wardnode
WARDNODE_PROJECT_DIR=/opt/wardnode
