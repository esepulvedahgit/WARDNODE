FLASK_APP=wsgi.py

# Generar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR-POR-VALOR-SEGURO

# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WARDNODE_SECRET_KEY=CAMBIAR-POR-FERNET-KEY

DATABASE_URL=postgresql+psycopg://app:CAMBIAR_PASSWORD@127.0.0.1:5432/app
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=CAMBIAR_PASSWORD

PROXY_CONFIG_DIR=/app/generated/nginx
GEOIP_DB_PATH=/app/data/geoip/GeoLite2-Country.mmdb
NGINX_CONTAINER_NAME=wardnode-proxy

SESSION_COOKIE_SECURE=true
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URI=memory://
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_SHOW_TOKEN=false

# WardNode OBS — contraseña del admin de Grafana (módulo observabilidad)
GRAFANA_ADMIN_PASSWORD=CAMBIAR-POR-CONTRASENA-SEGURA
