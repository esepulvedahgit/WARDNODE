// ─────────────────────────────────────────────────────────────────────────────
// WardNode Observability — Grafana Alloy
//
// Recolecta logs de NGINX, ModSecurity v3 y UFW → Loki
// Recolecta métricas del host (unix exporter) → Prometheus
//
// Labels de Loki en uso (baja cardinalidad):
//   job, service, waf
// Campos de alta cardinalidad (src_ip, uri, rule_id…) se mantienen dentro
// del JSON del log y se consultan con parsers LogQL, no como labels.
// ─────────────────────────────────────────────────────────────────────────────

// ── Salidas ──────────────────────────────────────────────────────────────────

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ── Logs: ModSecurity v3 (SecAuditLogFormat JSON) ────────────────────────────
// La imagen OWASP CRS nginx escribe el JSON de auditoría a stdout del
// contenedor, no a archivo. Leemos directamente desde Docker.

discovery.docker "proxy_container" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "name"
    values = ["wardnode-proxy"]
  }
}

discovery.relabel "modsecurity" {
  targets = discovery.docker.proxy_container.targets
  rule {
    target_label = "job"
    replacement  = "modsecurity"
  }
  rule {
    target_label = "service"
    replacement  = "nginx"
  }
  rule {
    target_label = "waf"
    replacement  = "modsecurity"
  }
}

loki.source.docker "modsecurity" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.modsecurity.output
  forward_to = [loki.process.modsec_json.receiver]
}

loki.process "modsec_json" {
  stage.drop {
    expression = "^[^{]"
  }
  forward_to = [loki.write.default.receiver]
}

// ── Logs: NGINX access (formato json_combined) ────────────────────────────────

local.file_match "nginx_access" {
  path_targets = [{
    "__path__" = "/var/log/nginx/access.json",
    "job"      = "nginx_access",
    "service"  = "nginx",
  }]
}

loki.source.file "nginx_access" {
  targets    = local.file_match.nginx_access.targets
  forward_to = [loki.write.default.receiver]
}

// ── Logs: NGINX error log ─────────────────────────────────────────────────────
// El proxy escribe /var/log/nginx/error.log (texto plano, no JSON).
// Alloy lo ingiere crudo — los paneles del dashboard "NGINX Logs" lo muestran
// como texto sin pipeline de parseo.

local.file_match "nginx_error" {
  path_targets = [{
    "__path__" = "/var/log/nginx/error.log",
    "job"      = "nginx_error",
    "service"  = "nginx",
  }]
}

loki.source.file "nginx_error" {
  targets    = local.file_match.nginx_error.targets
  forward_to = [loki.write.default.receiver]
}

// ── Logs: UFW firewall del host ───────────────────────────────────────────────
// UFW registra en /var/log/kern.log cuando rsyslog no tiene una regla de
// separación (/etc/rsyslog.d/20-ufw.conf). Se filtra kern.log para pasar
// únicamente las líneas que contienen [UFW ] y descartar el ruido del kernel.

local.file_match "ufw" {
  path_targets = [{
    "__path__" = "/rootfs/var/log/kern.log",
    "job"      = "ufw",
    "service"  = "firewall",
  }]
}

loki.process "ufw_filter" {
  stage.match {
    selector = `{job="ufw"} != "[UFW "`
    action   = "drop"
  }
  forward_to = [loki.write.default.receiver]
}

loki.source.file "ufw" {
  targets    = local.file_match.ufw.targets
  forward_to = [loki.process.ufw_filter.receiver]
}

// ── Métricas del host (reemplaza node-exporter) ───────────────────────────────
// Requiere montajes: /proc:/host/proc:ro  /sys:/host/sys:ro  /:/rootfs:ro
// Colectores deshabilitados: los que no aplican a este servidor.

prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/rootfs"

  disable_collectors = [
    "arp",
    "bcache",
    "bonding",
    "btrfs",
    "cpufreq",
    "drbd",
    "fibrechannel",
    "infiniband",
    "ipvs",
    "nfs",
    "nfsd",
    "nvme",
    "powersupplyclass",
    "rapl",
    "schedstat",
    "selinux",
    "softnet",
    "tapestats",
    "textfile",
    "thermal_zone",
    "udp_queues",
    "zfs",
  ]
}

prometheus.scrape "host_metrics" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.remote_write.prometheus.receiver]
  job_name        = "node"
  scrape_interval = "15s"
}

// ── Métricas de NGINX (nginx-prometheus-exporter sobre stub_status) ──────────
// El contenedor wardnode-nginx-exporter scrapea /stub_status del proxy y expone
// sus métricas en :9113. Alloy las reenvía a Prometheus como job "nginx".
// Métricas clave: nginx_up, nginx_connections_active/reading/writing/waiting,
// nginx_connections_accepted/handled, nginx_http_requests_total.

prometheus.scrape "nginx" {
  targets = [{ "__address__" = "wardnode-nginx-exporter:9113" }]
  forward_to      = [prometheus.remote_write.prometheus.receiver]
  job_name        = "nginx"
  scrape_interval = "15s"
}

// ── Auto-observabilidad: métricas del propio Alloy ────────────────────────────

prometheus.scrape "alloy_self" {
  targets = [{
    "__address__" = "127.0.0.1:12345",
  }]
  forward_to      = [prometheus.remote_write.prometheus.receiver]
  job_name        = "alloy"
  metrics_path    = "/metrics"
  scrape_interval = "60s"
}
