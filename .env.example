FLASK_APP=wsgi.py
FLASK_DEBUG=1
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
PROXY_CONFIG_DIR=/app/generated/nginx
GEOIP_DB_PATH=/app/data/geoip/GeoLite2-Country.mmdb
NGINX_CONTAINER_NAME=wardnode-proxy
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WARDNODE_SECRET_KEY=Gdkavs0E-mq_s-EZwsSix8qd5RvatmF2-uN86Qt-oeE=
SESSION_COOKIE_SECURE=false
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URI=memory://
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_SHOW_TOKEN=false
# WardNode OBS — contraseña del admin de Grafana (solo VPS)
GRAFANA_ADMIN_PASSWORD=wardnode
# Ruta absoluta al directorio del proyecto en el VPS host (necesaria para que el módulo OBS
# levante los contenedores de observabilidad desde el panel. Ej: /opt/wardnode)
WARDNODE_PROJECT_DIR=
