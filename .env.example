FLASK_APP=wsgi.py
FLASK_DEBUG=1
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# OBLIGATORIO en producción — no usar el valor por defecto.
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
PROXY_CONFIG_DIR=/app/generated/nginx
GEOIP_DB_PATH=/app/data/geoip/GeoLite2-Country.mmdb
NGINX_CONTAINER_NAME=wardnode-proxy
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Obligatoria para cifrar secretos en BD: MaxMind, SMTP, claves LLM del SOC, token Telegram
WARDNODE_SECRET_KEY=Gdkavs0E-mq_s-EZwsSix8qd5RvatmF2-uN86Qt-oeE=
# Contenedor del que se ingieren los eventos ModSecurity (WAF Events + módulo SOC)
WARDNODE_PROXY_CONTAINER=wardnode-proxy
SESSION_COOKIE_SECURE=false
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URI=memory://
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_SHOW_TOKEN=false
# URL pública de la consola (usada para construir el enlace en correos de recuperación).
# Dejar vacío en dev si se usa PASSWORD_RESET_SHOW_TOKEN=true (el enlace se muestra en pantalla).
PUBLIC_BASE_URL=http://localhost:5000
# WardNode OBS — contraseña del admin de Grafana (solo VPS). OBLIGATORIO si se usa el perfil obs.
# Generar con: python -c "import secrets; print(secrets.token_hex(16))"
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Puerto de escucha de gunicorn. Por defecto 0.0.0.0:5000 para permitir el
# acceso inicial por IP durante el bootstrap. Tras activar WardNode WF, el
# firewall del host (UFW) bloquea TCP:5000 y el acceso queda solo vía dominio + TLS.
# GUNICORN_BIND=0.0.0.0:5000
# Ruta absoluta al directorio del proyecto en el VPS host (necesaria para que el módulo OBS
# levante los contenedores de observabilidad desde el panel. Ej: /opt/wardnode)
WARDNODE_PROJECT_DIR=
